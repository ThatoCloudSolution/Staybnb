@model List<Staybnb.Models.Booking>
@{
    ViewData["Title"] = "Host Dashboard";
}

<h2>Welcome back, @User.Identity!.Name!</h2>
<p class="text-muted">Here's what's happening with your properties today.</p>

<div class="row mb-4">
    <div class="col-md-3"><div class="card p-3"><h5>@ViewBag.TotalProperties</h5><small>Total Properties</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h5>@ViewBag.TotalBookings</h5><small>Total Bookings</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h5>R @ViewBag.TotalEarnings.ToString("N2")</h5><small>Total Earnings</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h5>@ViewBag.ActiveProperties</h5><small>Active Listings</small></div></div>
</div>

<h3>Booking Requests</h3>
<table class="table">
    <thead>
        <tr><th>Property</th><th>Guest</th><th>Dates</th><th>Total</th><th>Status</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Property?.Title</td>
                <td>@b.Guest?.FirstName @b.Guest?.LastName</td>
                <td>@b.CheckInDate.ToShortDateString() → @b.CheckOutDate.ToShortDateString()</td>
                <td>R @b.TotalPrice.ToString("N2")</td>
                <td>@b.Status</td>
                <td>
                    @if (b.Status == Staybnb.Models.BookingStatus.Pending)
                    {
                        <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post" style="display:inline">
                            <button class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post" style="display:inline">
                            <button class="btn btn-sm btn-danger">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>