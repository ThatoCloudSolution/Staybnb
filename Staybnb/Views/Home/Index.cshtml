@model List<Staybnb.Models.HostProperty>
@{
    ViewData["Title"] = "Staybnb";
}

<h1>Relax. Unwind. Choose your next stay.</h1>

<form method="get" class="row g-2 my-4">
    <div class="col-md-4">
        <select name="city" class="form-select">
            <option value="">Anywhere</option>
            @foreach (var c in (List<string>)ViewBag.Cities)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input name="type" class="form-control" placeholder="Property type" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-danger w-100">Search</button>
    </div>
</form>

<div class="row">
    @foreach (var p in Model)
    {
        var img = p.Images.FirstOrDefault()?.ImageUrl ?? "/images/placeholder.jpg";
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="@img" class="card-img-top" style="height:220px;object-fit:cover" />
                <div class="card-body">
                    <h5>@p.Title</h5>
                    <p class="text-muted mb-1">📍 @p.City</p>
                    <p><strong>R @p.PricePerNight.ToString("N0")</strong> / night</p>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-danger">View</a>
                </div>
            </div>
        </div>
    }
</div>