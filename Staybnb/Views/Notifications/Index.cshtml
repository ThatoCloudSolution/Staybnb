@model List<Staybnb.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>
<form asp-action="MarkAllRead" method="post" style="display:inline">
    <button class="btn btn-sm btn-outline-primary">Mark all as read</button>
</form>

<div class="mt-3">
    @foreach (var n in Model)
    {
        <div class="card mb-2 @(n.IsRead ? "" : "border-primary")">
            <div class="card-body">
                <h6>@n.Title @(n.IsRead ? "" : "🔴")</h6>
                <p class="mb-1">@n.Message</p>
                <small class="text-muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
        </div>
    }
</div>