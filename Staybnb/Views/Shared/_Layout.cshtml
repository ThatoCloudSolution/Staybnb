<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container">
        <a class="navbar-brand text-danger fw-bold" asp-controller="Home" asp-action="Index">🏠 staybnb</a>
        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Host"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="HostDashboard" asp-action="Index">Host Dashboard</a></li>
                    }
                    if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">Admin</a></li>
                    }
                    if (User.IsInRole("Guest"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="HostApplication" asp-action="Apply">Become a Host</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index">🔔 Notifications</a></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button class="btn btn-link nav-link">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>