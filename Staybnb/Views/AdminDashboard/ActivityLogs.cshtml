@model List<Staybnb.Models.ActivityLog>
@{
    ViewData["Title"] = "Activity Logs";
}

<h2>System Audit Log</h2>

<table class="table">
    <thead><tr><th>User</th><th>Action</th><th>Type</th><th>Timestamp</th></tr></thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.User?.Email</td>
                <td>@log.Action</td>
                <td>@log.ActivityType</td>
                <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
    </tbody>
</table>