@model List<Staybnb.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (!Model.Any())
{
    <p>You have no bookings yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Property</th><th>Dates</th><th>Total</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Property?.Title</td>
                    <td>@b.CheckInDate.ToShortDateString() → @b.CheckOutDate.ToShortDateString()</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td>@b.Status</td>
                </tr>
            }
        </tbody>
    </table>
}